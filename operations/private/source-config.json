{
  "schema_version": "1.2",
  "request_timeout_seconds": 30,
  "initial_lookback_days": 7,
  "paper_manual_primary_source_fallback": true,
  "price_source": {
    "enabled": true,
    "provider": "yahoo_finance_unofficial_tracked_archive",
    "manifest_path": "data/daily-prices/latest.json",
    "minimum_daily_archive_coverage": 0.98,
    "minimum_active_target_coverage": 1.0,
    "maximum_latest_price_age_days": 7
  },
  "edinet": {
    "enabled": true,
    "base_url": "https://api.edinet-fsa.go.jp/api/v2",
    "api_key_env": "EDINET_API_KEY"
  },
  "market_regime": {
    "enabled": true,
    "jpx_monthly_statistics_pages": [
      "https://www.jpx.co.jp/markets/statistics-equities/monthly/index.html",
      "https://www.jpx.co.jp/markets/statistics-equities/monthly/00-archives-01.html",
      "https://www.jpx.co.jp/markets/statistics-equities/monthly/00-archives-02.html"
    ],
    "nikkei_vi_csv_url": "https://indexes.nikkei.co.jp/nkave/historical/nikkei_stock_average_vi_daily_en.csv",
    "leading_ci_page_url": "https://www.esri.cao.go.jp/jp/stat/di/di.html",
    "minimum_vi_observations": 500,
    "breadth_lookback_sessions": 280,
    "maximum_breadth_close_age_days": 7,
    "minimum_breadth_coverage": 0.98
  },
  "manual_primary_sources": {
    "company_ir": true,
    "tdnet": true,
    "jpx_notices": true,
    "official_prices_and_corporate_actions": true,
    "trading_calendar": true
  }
}
